# Skills directory
/skills/
# ── GhostPatch: never snapshot runtime data ──────────────────────────────
# Job videos (up to 3 copies per job) + SQLite db are regenerated at runtime.
# The platform auto-commits the repo for durability — keeping these out is
# what keeps snapshots small, fast and reliable.
/db/
/upload/
/download/
/research/
/tool-results/
/tests/
tsconfig.tsbuildinfo

# ── sandbox platform scaffolding — never belongs in the public repo ─────────
/.zscripts/
/examples/
/mini-services/
/scripts/
/Caddyfile
/agent-ctx/

